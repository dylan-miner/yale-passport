# Supabase — public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only, never expose to the browser
SUPABASE_SECRET_KEY=

# Supabase Postgres — session pooler URI, only needed for `npm run migrate`
# (Dashboard → Connect → Session pooler)
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# OpenAI — concierge LLM
OPENAI_API_KEY=

# Twilio — SMS (optional; concierge works in-app without it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: override the seeded demo account password
# DEMO_USER_PASSWORD=
